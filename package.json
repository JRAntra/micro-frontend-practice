{
  "name": "micro-frontend-practice",
  "version": "1.0.0",
  "description": "A guided, six-step Module Federation lab on an Nx monorepo. Runs entirely on your own machine.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.11.1 || ^22.12.0 || ^24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node tools/check-node.cjs",
    "postinstall": "node tools/doctor.cjs --quiet",
    "prestart": "node tools/check-node.cjs",
    "start": "nx serve shell",
    "start:remote": "nx serve products",
    "prebuild": "node tools/check-node.cjs",
    "build": "nx run-many -t build --projects=shell,products",
    "serve:dist": "node -r @swc-node/register tools/serve-dist.ts",
    "verify:build": "npm run build && node -r @swc-node/register tools/verify-build.ts",
    "pretest": "node tools/check-node.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:units": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node tools/doctor.cjs",
    "clean": "node tools/clean.cjs",
    "graph": "nx graph"
  },
  "dependencies": {
    "@angular/common": "~19.2.0",
    "@angular/compiler": "~19.2.0",
    "@angular/core": "~19.2.0",
    "@angular/forms": "~19.2.0",
    "@angular/platform-browser": "~19.2.0",
    "@angular/platform-browser-dynamic": "~19.2.0",
    "@angular/router": "~19.2.0",
    "@nx/angular": "20.8.4",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.2.0",
    "@angular-devkit/core": "~19.2.0",
    "@angular-devkit/schematics": "~19.2.0",
    "@angular/cli": "~19.2.0",
    "@angular/compiler-cli": "~19.2.0",
    "@angular/language-service": "~19.2.0",
    "@eslint/js": "^9.8.0",
    "@module-federation/enhanced": "^0.9.0",
    "@nx/eslint": "20.8.4",
    "@nx/eslint-plugin": "20.8.4",
    "@nx/jest": "20.8.4",
    "@nx/js": "20.8.4",
    "@nx/module-federation": "20.8.4",
    "@nx/web": "20.8.4",
    "@nx/webpack": "20.8.4",
    "@nx/workspace": "20.8.4",
    "@schematics/angular": "~19.2.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@typescript-eslint/utils": "^8.19.0",
    "angular-eslint": "^19.2.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.4.0",
    "nx": "20.8.4",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "overrides": {
    "@rspack/core": "1.3.15"
  }
}
